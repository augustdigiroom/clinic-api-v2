generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model doctors {
  id             Int           @id @default(autoincrement())
  first_name     String        @db.VarChar(100)
  last_name      String        @db.VarChar(100)
  specialization String        @db.VarChar(100)

  patients       patients[]
  appointments   appointments[]
}

model patients {
  id             Int      @id @default(autoincrement())
  first_name     String   @db.VarChar(100)
  last_name      String   @db.VarChar(100)
  age            Int?
  gender         String?  @db.VarChar(20)
  diagnosis      String?
  contact_number String?  @unique(map: "unique_patient_contact") @db.VarChar(30)
  doctor_id      Int?

  doctors      doctors?      @relation(fields: [doctor_id], references: [id], onUpdate: NoAction, map: "fk_patient_doctor")
  appointments appointments[]

  @@index([last_name], map: "idx_patients_last_name")
}

model appointments {
  id               Int      @id @default(autoincrement())
  patient_id       Int
  doctor_id        Int?
  appointment_date DateTime @db.Timestamp
  reason           String   @db.VarChar(100)
  status           String   @db.VarChar(20)

  doctors doctors? @relation(fields: [doctor_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_appointment_doctor")
  patient patients @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_appointment_patient")
}